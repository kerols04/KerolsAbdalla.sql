-- Radera eventuella befintliga vyer och procedurer som ska återskapas
DROP VIEW IF EXISTS v_TitlarPerFörfattare;
DROP VIEW IF EXISTS v_OrdrarPerKund;
DROP PROCEDURE IF EXISTS usp_FlyttaBok;

-- Radera eventuella befintliga tabeller (droppas i rätt ordning p.g.a. FK-relationer)
DROP TABLE IF EXISTS Orderrader;       -- Mellantabell ordrar-böcker (junction för orderdetaljer)
DROP TABLE IF EXISTS BockerForfattare; -- Mellantabell böcker-författare (junction för många-till-många)
DROP TABLE IF EXISTS LagerSaldo;       -- LagerSaldo refererar Butiker och Böcker
DROP TABLE IF EXISTS Ordrar;          -- Ordrar refererar Kunder och Butiker
DROP TABLE IF EXISTS Bocker;          -- Böcker refererar Förlag och Kategorier
DROP TABLE IF EXISTS Forfattare;
DROP TABLE IF EXISTS Kunder;
DROP TABLE IF EXISTS Butiker;
DROP TABLE IF EXISTS Forlag;
DROP TABLE IF EXISTS Kategorier;
-- Tabell Författare: innehåller ID (Identity PK), förnamn, efternamn, födelsedatum
CREATE TABLE Forfattare (
    ID INT IDENTITY(1,1) NOT NULL,
    Förnamn NVARCHAR(50) NOT NULL,
    Efternamn NVARCHAR(50) NOT NULL,
    Födelsedatum DATE NOT NULL,
    CONSTRAINT PK_Forfattare PRIMARY KEY (ID)
);

-- Tabell Förlag: innehåller FörlagID (Identity PK) och namn på förlaget
CREATE TABLE Forlag (
    FörlagID INT IDENTITY(1,1) NOT NULL,
    Namn NVARCHAR(100) NOT NULL,
    CONSTRAINT PK_Forlag PRIMARY KEY (FörlagID)
);

-- Tabell Kategorier: innehåller KategoriID (Identity PK) och kategorinamn (t.ex. genre)
CREATE TABLE Kategorier (
    KategoriID INT IDENTITY(1,1) NOT NULL,
    Namn NVARCHAR(50) NOT NULL,
    CONSTRAINT PK_Kategorier PRIMARY KEY (KategoriID)
);

-- Tabell Böcker: innehåller ISBN13 (PK), titel, språk, pris, utgivningsdatum, samt FK till Förlag och Kategorier.
-- (Författarrelation hanteras via mellantabell BockerForfattare för att stödja flera författare per bok)
CREATE TABLE Bocker (
    ISBN CHAR(13) NOT NULL,            -- ISBN-13, 13 tecken
    Titel NVARCHAR(100) NOT NULL,
    Språk NVARCHAR(20) NOT NULL,
    Pris DECIMAL(8,2) NOT NULL,
    Utgivningsdatum DATE NOT NULL,
    FörlagID INT NOT NULL,
    KategoriID INT NOT NULL,
    CONSTRAINT PK_Bocker PRIMARY KEY (ISBN),
    CONSTRAINT FK_Bocker_Forlag FOREIGN KEY (FörlagID) REFERENCES Forlag(FörlagID),
    CONSTRAINT FK_Bocker_Kategori FOREIGN KEY (KategoriID) REFERENCES Kategorier(KategoriID),
    CONSTRAINT CK_Bocker_ISBN_Numeric CHECK (ISBN NOT LIKE '%[^0-9]%'),   -- ISBN får endast innehålla siffror
    CONSTRAINT CK_Bocker_Pris_Positive CHECK (Pris > 0)                   -- Pris måste vara större än 0
);

-- Tabell Butiker: innehåller ButikID (Identity PK), namn och adressuppgifter för butikerna
CREATE TABLE Butiker (
    ButikID INT IDENTITY(1,1) NOT NULL,
    ButikNamn NVARCHAR(100) NOT NULL,
    Adress NVARCHAR(100) NOT NULL,
    Postnummer NVARCHAR(10) NOT NULL,
    Stad NVARCHAR(50) NOT NULL,
    CONSTRAINT PK_Butiker PRIMARY KEY (ButikID)
);

-- Tabell Kunder: innehåller KundID (Identity PK), namn och kontaktuppgifter för kunder
CREATE TABLE Kunder (
    KundID INT IDENTITY(1,1) NOT NULL,
    Förnamn NVARCHAR(50) NOT NULL,
    Efternamn NVARCHAR(50) NOT NULL,
    Epost NVARCHAR(100) NOT NULL,
    CONSTRAINT PK_Kunder PRIMARY KEY (KundID)
);

-- Tabell Ordrar: innehåller OrderID (Identity PK), datum, samt FK till Kund och Butik för varje order
CREATE TABLE Ordrar (
    OrderID INT IDENTITY(1,1) NOT NULL,
    OrderDatum DATE NOT NULL,
    KundID INT NOT NULL,
    ButikID INT NOT NULL,
    CONSTRAINT PK_Ordrar PRIMARY KEY (OrderID),
    CONSTRAINT FK_Ordrar_Kund FOREIGN KEY (KundID) REFERENCES Kunder(KundID),
    CONSTRAINT FK_Ordrar_Butik FOREIGN KEY (ButikID) REFERENCES Butiker(ButikID)
);

-- Tabell LagerSaldo: många-till-många-relation mellan Butiker och Böcker, med kolumn för lagersaldo (antal i lager)
CREATE TABLE LagerSaldo (
    ButikID INT NOT NULL,
    ISBN CHAR(13) NOT NULL,
    Antal INT NOT NULL,
    CONSTRAINT PK_LagerSaldo PRIMARY KEY (ButikID, ISBN),
    CONSTRAINT FK_LagerSaldo_Butik FOREIGN KEY (ButikID) REFERENCES Butiker(ButikID) ON DELETE CASCADE,
    CONSTRAINT FK_LagerSaldo_Bok FOREIGN KEY (ISBN) REFERENCES Bocker(ISBN) ON DELETE CASCADE,
    CONSTRAINT CK_LagerSaldo_NonNegative CHECK (Antal >= 0)  -- Antal i lager får inte vara negativt
);

-- Tabell BockerForfattare: junction-tabell för många-till-många-relationen mellan Böcker och Författare
CREATE TABLE BockerForfattare (
    FörfattareID INT NOT NULL,
    ISBN CHAR(13) NOT NULL,
    CONSTRAINT PK_BockerForfattare PRIMARY KEY (FörfattareID, ISBN),
    CONSTRAINT FK_BockerForfattare_Forfattare FOREIGN KEY (FörfattareID) REFERENCES Forfattare(ID) 
        ON DELETE NO ACTION,   -- (Förhindra borttag om författaren har böcker)
    CONSTRAINT FK_BockerForfattare_Bok FOREIGN KEY (ISBN) REFERENCES Bocker(ISBN) 
        ON DELETE CASCADE     -- (Om en bok tas bort, radera dess kopplingar här)
);

-- Tabell Orderrader: junction-tabell för att lagra flera böcker per order (orderdetaljer med antal av varje bok)
CREATE TABLE Orderrader (
    OrderID INT NOT NULL,
    ISBN CHAR(13) NOT NULL,
    Antal INT NOT NULL,
    CONSTRAINT PK_Orderrader PRIMARY KEY (OrderID, ISBN),
    CONSTRAINT FK_Orderrader_Order FOREIGN KEY (OrderID) REFERENCES Ordrar(OrderID) ON DELETE CASCADE,
    CONSTRAINT FK_Orderrader_Bok FOREIGN KEY (ISBN) REFERENCES Bocker(ISBN),
    CONSTRAINT CK_Orderrader_PositiveQty CHECK (Antal > 0)  -- Antal böcker i en orderrad måste vara minst 1
);
