-- Vy v_TitlarPerFörfattare: sammanställning per författare av namn, ålder, antal titlar och totalt lagervärde
CREATE VIEW v_TitlarPerFörfattare AS
SELECT 
    -- Hela författarens namn
    [Namn] = f.Förnamn + N' ' + f.Efternamn,
    -- Beräknad ålder i år (baserat på födelsedatum)
    [Ålder] = CAST(DATEDIFF(YEAR, f.Födelsedatum, GETDATE()) AS NVARCHAR(3)) + N' år',
    -- Antal olika titlar av denna författare i böcker-tabellen
    [Titlar] = CAST(COUNT(DISTINCT b.ISBN) AS NVARCHAR(4)) + N' st',
    -- Totalt lagervärde för författarens böcker (summa pris * antal i lager i alla butiker)
    [Lagervärde] = CAST(SUM(b.Pris * ls.Antal) AS NVARCHAR(12)) + N' kr'
FROM Forfattare f
LEFT JOIN BockerForfattare bf ON f.ID = bf.FörfattareID
LEFT JOIN Bocker b ON bf.ISBN = b.ISBN
LEFT JOIN LagerSaldo ls ON b.ISBN = ls.ISBN
GROUP BY f.Förnamn, f.Efternamn, f.Födelsedatum, f.ID;
-- Notera: LEFT JOIN gör att författare utan böcker visas med 0 titlar och 0 kr värde (om det skulle finnas några).

-- Vy v_OrdrarPerKund: aggregationsvy som visar antal ordrar per kund.
-- Denna vy kan användas av bokhandeln för att identifiera hur aktiva kunderna är (t.ex. flest ordrar per kund).
CREATE VIEW v_OrdrarPerKund AS
SELECT 
    [KundNamn] = k.Förnamn + N' ' + k.Efternamn,
    [AntalOrdrar] = ISNULL(COUNT(o.OrderID), 0)
FROM Kunder k
LEFT JOIN Ordrar o ON k.KundID = o.KundID
GROUP BY k.Förnamn, k.Efternamn, k.KundID;
-- Stored Procedure usp_FlyttaBok: flyttar exemplar av en bok från en butik till en annan på en säkert sätt.
CREATE PROCEDURE usp_FlyttaBok 
    @FranButikID INT,       -- ButikID att flytta från
    @TillButikID INT,       -- ButikID att flytta till
    @ISBN CHAR(13),         -- ISBN för boken som flyttas
    @Antal INT = 1          -- Antal exemplar att flytta (default 1)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;  -- Säkerställ att transaktionen avbryts vid eventuella fel
    
    -- Kontrollera inparametrar och integritetsvillkor:
    IF @Antal < 1
    BEGIN
        RAISERROR(N'Antal att flytta måste vara minst 1.', 16, 1);
        RETURN;
    END;
    IF @FranButikID = @TillButikID
    BEGIN
        RAISERROR(N'Källbutik och målbutik är samma - ingen flytt behövs.', 16, 1);
        RETURN;
    END;
    IF NOT EXISTS(SELECT 1 FROM Butiker WHERE ButikID = @FranButikID)
    BEGIN
        RAISERROR(N'Källbutiken med ID %d finns ej.', 16, 1, @FranButikID);
        RETURN;
    END;
    IF NOT EXISTS(SELECT 1 FROM Butiker WHERE ButikID = @TillButikID)
    BEGIN
        RAISERROR(N'Målbutiken med ID %d finns ej.', 16, 1, @TillButikID);
        RETURN;
    END;
    IF NOT EXISTS(SELECT 1 FROM Bocker WHERE ISBN = @ISBN)
    BEGIN
        RAISERROR(N'Boken med ISBN %s finns ej i sortimentet.', 16, 1, @ISBN);
        RETURN;
    END;
    
    DECLARE @Tillgangliga INT;
    SELECT @Tillgangliga = Antal 
    FROM LagerSaldo 
    WHERE ButikID = @FranButikID AND ISBN = @ISBN;
    
    IF @Tillgangliga IS NULL
    BEGIN
        RAISERROR(N'Boken (ISBN %s) finns inte i lager hos butik %d.', 16, 1, @ISBN, @FranButikID);
        RETURN;
    END;
    IF @Tillgangliga < @Antal
    BEGIN
        RAISERROR(N'Inte tillräckligt antal exemplar i källbutiken (ID %d). Tillgängligt: %d, önskat att flytta: %d.', 
                  16, 1, @FranButikID, @Tillgangliga, @Antal);
        RETURN;
    END;
    
    -- Påbörja transaktion för att genomföra flytten atomärt
    BEGIN TRANSACTION;
    BEGIN TRY
        -- Minska lagersaldot i källbutiken
        UPDATE LagerSaldo
        SET Antal = Antal - @Antal
        WHERE ButikID = @FranButikID AND ISBN = @ISBN;
        
        -- Öka (eller skapa) lagersaldot i målbutiken
        IF EXISTS (SELECT 1 FROM LagerSaldo WHERE ButikID = @TillButikID AND ISBN = @ISBN)
        BEGIN
            UPDATE LagerSaldo
            SET Antal = Antal + @Antal
            WHERE ButikID = @TillButikID AND ISBN = @ISBN;
        END
        ELSE
        BEGIN
            INSERT INTO LagerSaldo (ButikID, ISBN, Antal)
            VALUES (@TillButikID, @ISBN, @Antal);
        END;
        
        COMMIT TRANSACTION;
        PRINT N'Flyttade ' + CAST(@Antal AS NVARCHAR(10)) + N' st av ISBN ' + @ISBN 
              + N' från butik ' + CAST(@FranButikID AS NVARCHAR(10)) 
              + N' till butik ' + CAST(@TillButikID AS NVARCHAR(10)) + N'.';
    END TRY
    BEGIN CATCH
        -- Om fel inträffar: rulla tillbaka och visa felmeddelande
        IF @@TRANCOUNT > 0 
            ROLLBACK TRANSACTION;
        DECLARE @ErrMsg NVARCHAR(4000), @ErrState INT;
        SELECT @ErrMsg = ERROR_MESSAGE(), @ErrState = ERROR_STATE();
        RAISERROR(N'Fel vid flytt av bok: %s', 16, @ErrState, @ErrMsg);
    END CATCH
END;
